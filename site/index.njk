---
layout: layouts/base.njk
permalink: "index.html"
seoTitle: "{{ site.name }}"
seoDescription: "Site statique genere depuis Joomla"
canonicalUrl: "/"
ogTitle: "{{ site.name }}"
ogDescription: "Site statique genere depuis Joomla"
indexable: true
---
{% set indexablePages = pages | selectattr('indexable') | list %}
{% set firstPage = indexablePages | first %}
<h1>{{ site.name }}</h1>
<p>Bienvenue sur la version statique modernisee du site.</p>
{% if firstPage %}
<p><a href="{{ firstPage.url | url }}">Acceder au contenu</a></p>
{% endif %}

<h2>Pages disponibles</h2>
<ul>
  {% for p in indexablePages %}
  <li><a href="{{ p.url | url }}">{{ p.title }}</a></li>
  {% endfor %}
</ul>

