<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{% for page in pages %}{% if page.indexable %}
  <url>
    <loc>{{ site.baseUrl }}{{ page.canonicalUrl }}</loc>
  </url>
{% endif %}{% endfor %}
  <url>
    <loc>{{ site.baseUrl }}/</loc>
  </url>
</urlset>

